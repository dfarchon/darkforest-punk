# DF Punk — security policy for the npm/pnpm registry.
# Never put tokens or credentials in this file.

registry=https://registry.npmjs.org/
# Prefer lockfile integrity; do not auto-upgrade packages.
engine-strict=true
# Fail closed if an unexpected auth token is injected via env into project config checks (CI).
# Tokens belong in CI secrets / user-level config only, never in the repo.

{
  "name": "mud-template-react-ecs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm recursive run build",
    "dev": "mprocs",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:client": "pnpm --filter 'client' run dev",
    "dev:contracts": "pnpm --filter 'contracts' dev",
    "dev:anvil": "anvil --base-fee 0 --block-time 2",
    "dev:explorer": "bash scripts/run-explorer.sh",
    "setup:foundry": "bash scripts/setup-foundry.sh",
    "mud:up": "echo 'Refusing automatic mutable MUD upgrades. Pin a reviewed commit/version and update package.json + lockfile deliberately.' && exit 1",
    "format": "prettier --write 'packages/**/*'",
    "lint": "pnpm --recursive run lint",
    "lint-fix": "pnpm --recursive run lint-fix",
    "test": "pnpm recursive run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@eslint/js": "9.16.0",
    "@latticexyz/cli": "2.2.23-e1c2958b99c9fe4c7189ab24938e0978ff85a75f",
    "@latticexyz/common": "2.2.23-e1c2958b99c9fe4c7189ab24938e0978ff85a75f",
    "@latticexyz/explorer": "2.2.23-e1c2958b99c9fe4c7189ab24938e0978ff85a75f",
    "@latticexyz/store-indexer": "2.2.23-e1c2958b99c9fe4c7189ab24938e0978ff85a75f",
    "@types/debug": "4.1.12",
    "eslint": "9.16.0",
    "eslint-config-prettier": "9",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "56.0.1",
    "globals": "15.13.0",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "mprocs": "0.7.1",
    "prettier": "3.3.3",
    "prettier-plugin-solidity": "1.3.1",
    "prettier-plugin-tailwindcss": "0.6.6",
    "rimraf": "6.0.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.17.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json}": [
      "eslint"
    ],
    "*.{ts,tsx,js,json,sol,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.20.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
